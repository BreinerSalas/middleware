# --- Mongo ---
MONGODB_URI=mongodb://localhost:27017/smartflow

# --- HubSpot ---
# Token de Private App (Settings → Integrations → Private Apps → Create).
# Scopes requeridos:
#   crm.objects.deals.read      (leer el deal)
#   crm.objects.deals.write     (escribir id_orden_odoo en writeback)
#   crm.schemas.deals.read      (leer propiedades custom)
#   crm.objects.quotes.read     (listar cotizaciones del deal, leer line items)
#   crm.objects.quotes.write    (escribir id_presupuesto_odoo en writeback)
#   crm.schemas.quotes.read     (leer/crear propiedades custom en quotes)
#   crm.schemas.quotes.write    (idempotente; agrupado con schemas.read en
#                                muchas cuentas — el probe Q6 reporta exactamente)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_API_BASE=https://api.hubapi.com

# Client Secret de la Private App (pestaña "Auth" en HubSpot).
# Se usa para verificar la firma HMAC-SHA256 de los webhooks entrantes
# (header X-HubSpot-Signature-v3 sobre method+url+body+timestamp).
HUBSPOT_CLIENT_SECRET=
# Ventana de tolerancia del timestamp (replay protection) en ms.
# Default 5 minutos. Requests fuera de esta ventana son rechazados con 401.
HUBSPOT_WEBHOOK_TS_TOLERANCE_MS=300000

# Nombres de las propiedades custom en HubSpot Deal
HS_PROPERTY_ODOO_CUSTOMER_ID=id_cliente_odoo
HS_PROPERTY_ODOO_ORDER_ID=id_orden_odoo
HS_PROPERTY_ODOO_QUOTE_ID=id_presupuesto_odoo

# Nombres de las propiedades custom en HubSpot Quote
# (la cotizacion elegible = hs_status publicado Y pais_de_destino lleno)
HS_PROPERTY_QUOTE_COUNTRY=pais_de_destino
HS_PROPERTY_QUOTE_ODOO_QUOTE_ID=id_presupuesto_odoo

# CSV de hs_status que califican una cotizacion como elegible.
# Default: ['APPROVAL_NOT_NEEDED', 'APPROVED']. Confirmar con el probe Q1
# (scripts/probes/hubspot-quote-readiness.js) que estos son los valores reales
# en este portal de HubSpot.
HS_QUOTE_ELIGIBLE_STATUSES=APPROVAL_NOT_NEEDED,APPROVED

# --- Selector de pipeline Comercial Visual Branding ---
# CSV de stage IDs permitidos. Default: stage "Cierre Ganado" del pipeline
# Comercial Visual Branding (1409249445). Una sola entrada por default.
HS_ALLOWED_STAGE_IDS=1409249445

# CSV de pipeline IDs permitidos. Default: pipeline "Comercial Visual Branding"
# (t_5728252902aef7e9938dfcbb6cdc2af8).
HS_ALLOWED_PIPELINE_IDS=t_5728252902aef7e9938dfcbb6cdc2af8

# Si es true, rechaza (job -> SKIPPED) los deals cuya propiedad pipeline
# no esté en HS_ALLOWED_PIPELINE_IDS. Si es false, deja pasar el job y los
# validadores posteriores deciden.
HS_REJECT_UNKNOWN_PIPELINE=true

# --- Odoo ---
# Modo del cliente Odoo:
#   - stub : no llama a Odoo (retorna ids deterministicos)
#   - http : JSON-RPC nativo contra /jsonrpc (requiere las 4 vars)
ODOO_CLIENT_MODE=stub
ODOO_BASE_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_API_KEY=

# Partner de Odoo por defecto (res.partner.id) usado como fallback
# cuando el Deal no tiene la propiedad `id_cliente_odoo` seteada en
# HubSpot. Útil para setups single-tenant donde todos los deals van
# al mismo cliente en Odoo.
#
# Si está vacío, los Deals SIN `id_cliente_odoo` se rechazan con
# MISSING_ODOO_CUSTOMER_ID.
ODOO_DEFAULT_CUSTOMER_ID=

# --- Servidor ---
PORT=3007
NODE_ENV=development
LOG_LEVEL=info

# --- Worker ---
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL_MS=5000

# --- Reintentos ---
MAX_RETRY_ATTEMPTS=8
RETRY_MAX_DELAY_MS=300000

# --- Panel de administración ---
PANEL_TOKEN=
PANEL_TOKEN_HEADER_NAME=x-panel-token

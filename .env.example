# --- Mongo ---
MONGODB_URI=mongodb://localhost:27017/smartflow

# --- HubSpot ---
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_API_BASE=https://api.hubapi.com

# Webhook auth (HubSpot Workflow action — static shared secret)
WEBHOOK_SHARED_SECRET=
WEBHOOK_SHARED_SECRET_HEADER_NAME=x-smartflow-secret

# HubSpot custom property names
HS_PROPERTY_ODOO_CUSTOMER_ID=id_cliente_odoo
HS_PROPERTY_ODOO_ORDER_ID=id_orden_odoo

# --- Odoo ---
ODOO_CLIENT_MODE=stub
ODOO_BASE_URL=
ODOO_API_KEY=

# --- Server ---
PORT=3007
NODE_ENV=development
LOG_LEVEL=info

# --- Worker ---
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL_MS=5000

# --- Retry ---
MAX_RETRY_ATTEMPTS=8
RETRY_MAX_DELAY_MS=300000

# --- Admin panel ---
PANEL_TOKEN=
PANEL_TOKEN_HEADER_NAME=x-panel-token
